# WalletLedger settings. Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is git-ignored. Never commit real tokens or keys.

# --- First start ---------------------------------------------------------------
# `uv run uvicorn main:app` asks the setup questions on the first start and writes SETUP_DONE=true.
# SETUP_SKIP=1 means never ask (containers and services do not need it: they are never asked).
# SETUP_DONE=false

# --- Database -------------------------------------------------------------------
# Choose ONE backend:
#   sqlite   - a single local file. Zero setup, best for development and personal use.
#   postgres - a database server. Best for production / several users (run your own PostgreSQL server).
DB_MODE=sqlite

# sqlite settings
SQLITE_PATH=./walletledger.db

# postgres settings (used when DB_MODE=postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=appdb

# Advanced: a full SQLAlchemy URL overrides DB_MODE and the settings above, e.g.
#   DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/walletledger?sslmode=require
# DATABASE_URL=

# --- AI tools ---------------------------------------------------------------------
# How the AI calls ledger tools:
#   direct - plain Python calls inside the bot (default).
#   mcp    - through the real MCP server, started as a child process over stdio (demo mode).
TOOL_MODE=direct

# --- Security -------------------------------------------------------------------
# Encrypts users' AI keys, chat history and transaction notes in the database. Use a long random
# value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Only while changing SECRET_KEY: the previous value(s), comma-separated, so old data stays
# readable. Then run: uv run python scripts/protect_data.py rotate   (and remove this line)
# SECRET_KEY_OLD=

# --- Time ------------------------------------------------------------------------
# The timezone people live in. Times are stored in UTC; "today", daily totals, charts by hour and
# budget months follow this. Use a name like Asia/Kolkata, Europe/London, America/New_York.
TIMEZONE=Asia/Kolkata

# --- Telegram bot ---------------------------------------------------------------
# From @BotFather. Leave empty to disable the bot (POST /bot/simulate_chat still works).
TELEGRAM_BOT_TOKEN=
# Optional: more bots on the SAME backend, comma-separated (each from its own @BotFather chat).
# Every bot shares one ledger: a person's data follows their Telegram chat id, whichever bot they use.
# TELEGRAM_BOT_TOKENS=
# false = long polling (local dev, no public URL needed)
# true  = webhook (production): Telegram calls WEBHOOK_URL, which must be public HTTPS
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.example.com/bot/webhook
# Optional: secret Telegram sends with every webhook call (default: derived from the token)
TELEGRAM_WEBHOOK_SECRET=
# Largest statement upload accepted from chat (MB)
MAX_UPLOAD_MB=10

# --- Web dashboard & Telegram Mini App ----------------------------------------------
# Public https address of this server. With it, /dashboard opens inside Telegram as a Mini App.
# Empty = links point at http://localhost:8000 and open in a browser on this computer.
# Handy for a demo: a tunnel such as `cloudflared tunnel --url http://localhost:8000`.
PUBLIC_URL=
# How long a /dashboard link stays valid (minutes)
DASHBOARD_LINK_MINUTES=120

# --- AI (optional server keys) --------------------------------------------------
# Default model: every user brings their own key (/setkey <key>). Server keys below are an
# OPTIONAL fallback, used only for users whose own keys are missing or fail.
# Several keys = comma-separated, rotated round-robin.
GEMINI_API_KEYS=
OPENAI_API_KEYS=
ANTHROPIC_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
XAI_API_KEYS=
DEEPSEEK_API_KEYS=
MISTRAL_API_KEYS=
# Single-key variants (also accepted)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Models are discovered automatically: the gateway asks each provider which models your key can
# use and picks the best one, so you never maintain model names. Turn off with DYNAMIC_MODELS=false.
# Optional pins (override discovery; leave commented unless you need a specific model):
# AI_MODEL_GEMINI=gemini/gemini-flash-latest
# AI_MODEL_OPENAI=openai/gpt-4o-mini
# AI_MODEL_ANTHROPIC=anthropic/claude-3-5-sonnet-20241022
# AI_MODEL_GROQ=groq/llama-3.3-70b-versatile
# OLLAMA_API_BASE=http://localhost:11434

# --- Access control ---------------------------------------------------------------
# Only these Telegram chat ids may use the bot (comma-separated). Empty = anyone.
# Find your id by messaging @userinfobot.
ALLOWED_CHAT_IDS=
# Who may use /admin (shared AI keys, bot stats). Usually just you.
ADMIN_CHAT_IDS=
# /bot/simulate_chat and the token-less /bot/webhook let the caller act as ANY chat id.
# Leave unset: they are on only while TELEGRAM_BOT_TOKEN is empty (local dev).
# ENABLE_DEV_ENDPOINTS=false
# Show how the agent decided (ingress, planner, guard, executor, renderer) under every reply.
# One chat can switch it with /flow on|off. The terminal always prints these steps.
# SHOW_FLOW=false
# The terminal also prints file:line of each step (which function ran, who called it).
# FLOW_CODE=true
# A new user is asked ONE question on first contact (where do you pay from?). false = skip it.
# ONBOARDING=true
